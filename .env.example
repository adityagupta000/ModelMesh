# Copy to .env and fill in real values before running
DATABASE_URL=postgresql://user:pass@localhost/modelmesh
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production

# Test overrides (used by pytest)
TEST_DATABASE_URL=postgresql://user:pass@localhost/modelmesh_test
TEST_REDIS_URL=redis://localhost:6379/1

# Worker settings
WHISPER_MODEL=tiny
